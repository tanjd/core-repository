pnpm exec lint-staged

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  pre-commit run --files $STAGED_FILES
  git add -- $STAGED_FILES
fi

pnpm nx affected -t lint test e2e

# Whole-workspace invariant, not scoped to affected projects - cheap (just
# go.mod/pyproject.toml + jq, no Nx graph) so it isn't worth gating on nx
# affected.
bash tools/check-required-targets.sh
