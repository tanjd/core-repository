{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "defaultBase": "main",
  "extends": "nx/presets/npm.json",
  "generators": {
    "@nx-go/nx-go": {
      "projectNameAndRootFormat": "derived"
    },
    "@nx/next": {
      "application": {
        "linter": "eslint",
        "style": "tailwind"
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml"
    ]
  },
  "neverConnectToCloud": true,
  "parallel": 4,
  "plugins": [
    "@nx-go/nx-go",
    {
      "options": {
        "buildDepsTargetName": "build-deps",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "startTargetName": "start",
        "watchDepsTargetName": "watch-deps"
      },
      "plugin": "@nx/next/plugin"
    },
    {
      "options": {
        "targetName": "e2e"
      },
      "plugin": "@nx/playwright/plugin"
    },
    {
      "options": {
        "targetName": "lint"
      },
      "plugin": "@nx/eslint/plugin"
    },
    {
      "options": {
        "targetName": "test"
      },
      "plugin": "@nx/jest/plugin"
    },
    {
      "options": {
        "buildTargetName": "build",
        "devTargetName": "serve",
        "previewTargetName": "preview",
        "testTargetName": "test"
      },
      "plugin": "@nx/vite/plugin"
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "release": {
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github",
        "renderer": "{workspaceRoot}/tools/bookshelf-changelog/renderer.js"
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish [skip ci]",
      "push": true,
      "tag": true
    },
    "projects": [
      "food-maps-backend",
      "index-watch",
      "table-talks",
      "ledger-lens-backend",
      "ledger-lens",
      "bookshelf-backend",
      "bookshelf",
      "otobr-buddy"
    ],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targetDefaults": {
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "docker-build": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build -f apps/$NX_TASK_TARGET_PROJECT/Dockerfile -t $NX_TASK_TARGET_PROJECT --cache-from type=gha,scope=$NX_TASK_TARGET_PROJECT --cache-to type=gha,mode=max,scope=$NX_TASK_TARGET_PROJECT ."
      }
    },
    "docker-push": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build -f apps/$NX_TASK_TARGET_PROJECT/Dockerfile -t ghcr.io/tanjd/$NX_TASK_TARGET_PROJECT:latest -t ghcr.io/tanjd/$NX_TASK_TARGET_PROJECT:${GITHUB_SHA:-$(git rev-parse HEAD)} -t ghcr.io/tanjd/$NX_TASK_TARGET_PROJECT:v$(jq -r .version apps/$NX_TASK_TARGET_PROJECT/package.json) --cache-from type=gha,scope=$NX_TASK_TARGET_PROJECT --cache-to type=gha,mode=max,scope=$NX_TASK_TARGET_PROJECT --push ."
      }
    },
    "e2e-ci--**/*": {
      "dependsOn": [
        "^build"
      ]
    },
    "golangci-lint": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "dependsOn": [
        "golangci-lint",
        "tidy",
        "install"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "install"
      ]
    },
    "tidy": {
      "cache": true
    }
  },
  "tui": {
    "autoExit": true
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  }
}
