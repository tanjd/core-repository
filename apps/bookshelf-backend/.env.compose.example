# =============================================================================
# Bookshelf — Docker Compose environment
# =============================================================================
# Copy this file to .env in the same directory as docker-compose.yml:
#
#   cp .env.compose.example .env
#
# Then generate secrets (paste the output into .env):
#
#   openssl rand -base64 32   # run twice — once for each secret below
#
# Start the stack:
#
#   docker compose pull && docker compose up -d
#
# See apps/bookshelf/README.md for the full self-hosting guide.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Signs JWT session tokens. Must be a long random string — never use the
# placeholder below in production. The backend exits on startup when ENV=prd
# and this is still a default value.
JWT_SECRET=

# Encrypts sensitive values stored in the database (e.g. per-community Google
# Books API keys). Must be independent of JWT_SECRET so rotating one does not
# break the other.
ENCRYPTION_SECRET=

# The URL members use to reach Bookshelf in a browser. Used for CORS and for
# links in transactional emails (registration, password reset, loan updates).
#
# Examples:
#   http://192.168.1.10:3000          LAN / NAS IP
#   http://nas.tail12345.ts.net:3000  Tailscale hostname
#   https://books.example.com         public HTTPS (set this when behind a
#                                     reverse proxy — see README)
FRONTEND_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Environment mode
# -----------------------------------------------------------------------------

# dev  — default secrets allowed (with a warning); DEV_EMAIL_OVERRIDE works
# prd  — default secrets rejected; all mail goes to real recipients
ENV=dev

# -----------------------------------------------------------------------------
# Email (optional for solo testing, recommended for real communities)
# -----------------------------------------------------------------------------

# Leave SMTP_HOST empty to disable outbound email entirely. Registration
# magic links and loan notifications will be logged but not delivered.
#
# Works with any provider speaking SMTP + STARTTLS on port 587: Brevo, Amazon
# SES, Mailgun, Google Workspace / Gmail, etc.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bookshelf.local

# When ENV=dev, redirect every outgoing email to this address regardless of
# the intended recipient — handy for testing with multiple accounts without
# flooding real inboxes. Ignored when ENV=prd.
DEV_EMAIL_OVERRIDE=

# -----------------------------------------------------------------------------
# Telegram (optional)
# -----------------------------------------------------------------------------

# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram push notifications
# entirely — same "unset means skip" behavior as SMTP_HOST above.
# TELEGRAM_INTERNAL_SECRET guards the bot-only /internal/telegram/confirm-link
# endpoint and must match apps/bookshelf-bot's own BOOKSHELF_INTERNAL_TOKEN.
# Generate with: openssl rand -base64 32. TELEGRAM_BOT_USERNAME (no leading
# @) is returned to the frontend to build the "Connect Telegram" deep link.
# See apps/bookshelf/docs/telegram-bot-integration-spec.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_SECRET=
TELEGRAM_BOT_USERNAME=

# Optional: lets the admin Jobs page show whether apps/bookshelf-bot's own
# process is online (separate from whether push delivery works). Leave
# empty to hide that status instead of showing a false "offline". Point it
# at wherever you're running apps/bookshelf-bot's health server (default
# port 8080), reachable from the bookshelf-backend container.
TELEGRAM_BOT_HEALTH_URL=

# -----------------------------------------------------------------------------
# Book metadata (optional)
# -----------------------------------------------------------------------------

# Google Books API key(s). Open Library is always queried; Google Books is
# skipped when this is empty. Comma-separate multiple keys to round-robin
# across free-tier quotas (e.g. key1,key2,key3).
GOOGLE_BOOKS_API_KEY=
