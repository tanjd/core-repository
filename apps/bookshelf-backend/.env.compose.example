# Copy to .env next to docker-compose.yml (both gitignored). Generate the
# two secrets with:
#
#   openssl rand -base64 32

JWT_SECRET=
ENCRYPTION_SECRET=

# ENV=dev enables DEV_EMAIL_OVERRIDE below; ENV=prd disables it and always
# sends to the real recipient. Keep "dev" while this is internal testing.
ENV=dev

# Where you'll actually reach the frontend from a browser, e.g. your NAS's
# Tailscale hostname/IP: http://100.x.y.z:3000 or http://nas.tailXXXX.ts.net:3000
FRONTEND_ORIGIN=http://localhost:3000

# Leave SMTP_HOST blank to skip email entirely — OTP/notification emails
# will silently no-op (logged, not sent). Fine if you don't need email
# verification for solo testing. Set these to enable real sending (works
# with Brevo, Amazon SES, Mailgun, Gmail/Google Workspace — anything
# speaking SMTP+STARTTLS on port 587); set DEV_EMAIL_OVERRIDE to route
# every outgoing email to one inbox regardless of the actual recipient,
# useful while testing with multiple accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bookshelf.local
DEV_EMAIL_OVERRIDE=

# Optional — Open Library is always used for book metadata even without this.
GOOGLE_BOOKS_API_KEY=
