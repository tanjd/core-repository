# =============================================================================
# Backend Configuration (Go)
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Environment: "dev" or "prd"
ENV=dev

# Server port
PORT=8000

# Path to SQLite database file (relative to backend/)
DB_PATH=./data/bookshelf.db

# JWT signing secret (change in production!)
JWT_SECRET=changeme-use-a-long-random-string

# Encryption secret for field-level encryption (e.g. stored Google Books API keys).
# Defaults to JWT_SECRET if unset. Set this independently so rotating JWT_SECRET
# does not silently break stored encrypted values.
ENCRYPTION_SECRET=

# CORS origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Where the frontend is reachable from a browser — used to build links back
# into the app in transactional emails (e.g. loan request notifications,
# password reset). Usually matches the first CORS_ORIGINS entry.
FRONTEND_ORIGIN=http://localhost:3000

# SMTP settings for transactional email (optional — leave SMTP_HOST empty to
# disable email entirely). Works with any SMTP provider on port 587 with
# STARTTLS: Brevo, Amazon SES, Mailgun, Google Workspace/Gmail, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Email sender address
EMAIL_FROM=noreply@yourdomain.com

# Dev-only: redirect all outgoing emails to this address when ENV=dev (optional)
DEV_EMAIL_OVERRIDE=

# How often the background job refreshes cached book metadata (Go duration, e.g. 1h, 24h)
METADATA_REFRESH_INTERVAL=24h

# =============================================================================
# Book metadata
# =============================================================================

# Google Books API key (optional — Open Library is always used; Google Books skipped if empty)
GOOGLE_BOOKS_API_KEY=

# =============================================================================
# App config
# =============================================================================

# Path to bookshelf.yaml for seeding app settings on startup (optional).
# If the file exists, its values override the DB defaults at boot time.
# Generate a bookshelf.yaml snapshot from the Admin UI → Settings → Export YAML.
# APP_CONFIG_PATH=./bookshelf.yaml
