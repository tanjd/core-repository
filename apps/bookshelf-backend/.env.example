# =============================================================================
# Bookshelf backend — local development
# =============================================================================
# Copy to .env in this directory (apps/bookshelf-backend/):
#
#   cp .env.example .env
#
# Also create apps/bookshelf/.env.local with:
#
#   BACKEND_URL=http://localhost:8000
#
# Then from the repo root:
#
#   pnpm nx serve bookshelf-backend   # :8000
#   pnpm nx serve bookshelf           # :3000
#
# For Docker self-hosting, use .env.compose.example instead — see
# apps/bookshelf/README.md.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# dev  — default JWT/encryption secrets allowed (with a startup warning)
# prd  — default secrets rejected; use this to smoke-test production config
ENV=dev

PORT=8000

# SQLite database file (created automatically on first run)
DB_PATH=./data/bookshelf.db

# Required. Generate with: openssl rand -base64 32
# In production (ENV=prd), the server exits if these still match the defaults.
JWT_SECRET=changeme-use-a-long-random-string
ENCRYPTION_SECRET=changeme-use-a-different-long-random-string

# Browser-visible frontend URL — must match where apps/bookshelf is served.
# Used for CORS and email deep links.
CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (optional locally)
# -----------------------------------------------------------------------------

# Leave SMTP_HOST empty to skip sending. OTP and notification emails are
# logged but not delivered — fine for most local dev without a mail relay.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# When ENV=dev, route all outbound mail here instead of real recipients
DEV_EMAIL_OVERRIDE=

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------

# How often cached book metadata is refreshed (Go duration syntax)
METADATA_REFRESH_INTERVAL=24h

# -----------------------------------------------------------------------------
# Telegram (optional locally)
# -----------------------------------------------------------------------------

# Leave TELEGRAM_BOT_TOKEN empty to skip sending — Telegram push
# notifications are logged but not delivered, same as SMTP_HOST above.
# TELEGRAM_INTERNAL_SECRET guards POST /internal/telegram/confirm-link and
# must match apps/bookshelf-bot's BOOKSHELF_INTERNAL_TOKEN.
# TELEGRAM_BOT_USERNAME (no leading @) is returned to the frontend to build
# the "Connect Telegram" deep link. See
# apps/bookshelf/docs/telegram-bot-integration-spec.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_SECRET=
TELEGRAM_BOT_USERNAME=

# Optional: lets the admin Jobs page show whether apps/bookshelf-bot's own
# process is online (separate from whether push delivery works). Leave
# empty to hide that status instead of showing a false "offline".
# Local dev, if you're running the bot via `pnpm nx serve bookshelf-bot`:
# TELEGRAM_BOT_HEALTH_URL=http://localhost:8080/health
TELEGRAM_BOT_HEALTH_URL=

# -----------------------------------------------------------------------------
# Book metadata (optional)
# -----------------------------------------------------------------------------

# Google Books API key(s), comma-separated for round-robin. Open Library is
# always used; Google Books is skipped when empty.
GOOGLE_BOOKS_API_KEY=

# -----------------------------------------------------------------------------
# Advanced / testing
# -----------------------------------------------------------------------------

# Seed admin settings from a YAML file at startup (optional). Export a snapshot
# from Admin → Settings → Export YAML in a running instance.
# APP_CONFIG_PATH=./bookshelf.yaml

# Rate-limit overrides — defaults are sized for real communities; the e2e
# suite raises these via playwright.config.ts. Leave unset unless debugging
# auth rate limits.
# REGISTER_RATE_LIMIT_BURST=20
# REGISTER_SEND_RATE_LIMIT_BURST=30
# LOGIN_RATE_LIMIT_ATTEMPTS=5
