{
  "implicitDependencies": [
    "telegram-bot-shared"
  ],
  "name": "otobr-buddy",
  "projectType": "application",
  "sourceRoot": "apps/otobr-buddy/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --locked",
        "cwd": "apps/otobr-buddy"
      }
    },
    "docker-build": {},
    "docker-push": {},
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check . && uv run ruff format --check .",
        "cwd": "apps/otobr-buddy"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m otobr_buddy",
        "cwd": "apps/otobr-buddy"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/otobr-buddy"
      }
    }
  }
}
