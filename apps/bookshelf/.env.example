# =============================================================================
# Bookshelf frontend — local development
# =============================================================================
# Copy to .env.local in this directory (apps/bookshelf/):
#
#   cp .env.example .env.local
#
# .env.local is gitignored. BACKEND_URL is read at server startup by the
# Next.js API proxy (src/app/api/[...path]/route.ts) — it is not baked into
# the production Docker build.
#
# Also copy apps/bookshelf-backend/.env.example to .env and start both apps:
#
#   pnpm nx serve bookshelf-backend   # :8000
#   pnpm nx serve bookshelf           # :3000

BACKEND_URL=http://localhost:8000
