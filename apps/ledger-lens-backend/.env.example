# Directory where IBKR/Moomoo CSV files are watched and the SQLite DB is stored.
# Default: ./data (relative to the app working directory).
# Docker: overridden to /app/data (see Dockerfile).
LEDGER_DATA_DIR=./data

# CORS origins allowed to call the API (comma-separated).
LEDGER_CORS_ORIGINS=http://localhost:3000
