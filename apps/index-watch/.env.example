# =============================================================================
# REQUIRED: Bot Tokens
# =============================================================================

# Get tokens from @BotFather on Telegram
BOT_TOKEN=your_production_bot_token_here
BOT_TOKEN_DEV=your_development_bot_token_here

# =============================================================================
# OPTIONAL: Environment Configuration
# =============================================================================

# Environment: "dev" or "prd" (defaults to "prd" if not set)
# - "dev" uses BOT_TOKEN_DEV
# - anything else uses BOT_TOKEN
ENV=dev

# Health check server port, for Docker/Kubernetes liveness probes. Default: 8080
# HEALTH_CHECK_PORT=8080

# =============================================================================
# NOTIFICATIONS (BACKWARD COMPATIBILITY)
# =============================================================================

# DEPRECATED: Use /subscribe command instead of hardcoding chat IDs
# Comma-separated Telegram chat IDs (only used for initial migration to database)
# (Get your chat ID e.g. from @userinfobot or Bot API getUpdates after messaging the bot)
# These will be auto-migrated to the database on first startup.
TELEGRAM_CHAT_IDS=

# NOTE: After migration, use /subscribe command in Telegram to add new subscribers

# =============================================================================
# OPTIONAL: Admin & Security
# =============================================================================

# Comma-separated Telegram chat IDs with admin access (for /debug command)
# Leave empty to disable admin restrictions (not recommended for production)
# ADMIN_CHAT_IDS=123456789,987654321

# =============================================================================
# OPTIONAL: Drawdown & Reports
# =============================================================================

# Drawdown alert thresholds (percent). Default: 5 10 15 20
# DRAWDOWN_THRESHOLDS_PCT=5 10 15 20

# Daily report time (cron: minute hour day month weekday, UTC). Default: 22:00 Mon–Fri
# DAILY_REPORT_CRON=0 22 * * 1-5

# Minutes between drawdown threshold checks. Default: 60 (increased to reduce API load)
# ALERT_CHECK_MINUTES=60

# Years of history for ATH and "how often" stats. Default: 20
# HISTORY_YEARS=20

# Tracked indices as "symbol:Display Name" pairs separated by ";" (Yahoo Finance symbols).
# Default: S&P 500, NASDAQ-100, MSCI World (see config.py DEFAULT_INDEX_SYMBOLS)
# INDEX_SYMBOLS=^GSPC:S&P 500;^NDX:NASDAQ-100;^990100-USD-STRD:MSCI World

# =============================================================================
# OPTIONAL: Display & Storage
# =============================================================================

# Timezone for displaying timestamps in messages. Default: Asia/Singapore (GMT+8)
# Use IANA timezone names (e.g., America/New_York, Europe/London, Asia/Tokyo)
# DISPLAY_TIMEZONE=Asia/Singapore

# Database file path. Default: data/index_watch.db (relative to project root; inside
# Docker this resolves to /app/apps/index-watch/data/index_watch.db). Override this to
# match wherever your volume is mounted, e.g. DB_PATH=/app/data/index_watch.db if you
# mount your volume at /app/data instead.
# DB_PATH=data/index_watch.db

# =============================================================================
# OPTIONAL: Performance & Caching
# =============================================================================

# Cache time-to-live in seconds for market data. Default: 1800 (30 minutes)
# Caching reduces API load and speeds up /daily command responses
# CACHE_TTL_SECONDS=1800
