# =============================================================================
# REQUIRED: Bot Tokens
# =============================================================================

# Get tokens from @BotFather on Telegram
BOT_TOKEN=your_production_bot_token_here
BOT_TOKEN_DEV=your_development_bot_token_here

# =============================================================================
# OPTIONAL: Environment Configuration
# =============================================================================

# Environment: "dev" or "prd" (defaults to "prd" if not set)
# - "dev" uses BOT_TOKEN_DEV
# - anything else uses BOT_TOKEN
ENV=dev

# Port for the container's health-check HTTP endpoint (GET /health)
HEALTH_CHECK_PORT=8080

# =============================================================================
# REQUIRED: bookshelf-backend link
# =============================================================================

# bookshelf-backend's base URL — this bot calls it to complete the
# "Connect Telegram" deep link. Local dev default assumes both apps are
# running on the standard ports from apps/bookshelf-backend/.env.example.
BOOKSHELF_BACKEND_URL=http://localhost:8000

# Must match bookshelf-backend's own TELEGRAM_INTERNAL_SECRET.
BOOKSHELF_INTERNAL_TOKEN=changeme-use-a-long-random-string
