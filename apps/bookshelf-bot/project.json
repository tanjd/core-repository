{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "telegram-bot-shared"
  ],
  "name": "bookshelf-bot",
  "projectType": "application",
  "sourceRoot": "apps/bookshelf-bot/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --locked",
        "cwd": "apps/bookshelf-bot"
      }
    },
    "docker-build": {},
    "docker-push": {},
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check . && uv run ruff format --check .",
        "cwd": "apps/bookshelf-bot"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m bookshelf_bot",
        "cwd": "apps/bookshelf-bot"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/bookshelf-bot"
      }
    }
  }
}
