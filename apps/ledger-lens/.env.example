# Backend API URL used at request time by the server-side proxy route
# (src/app/api/[...path]/route.ts). Defaults to http://localhost:8000 for
# local dev; set to the Docker Compose service name (http://backend:8000)
# when running via docker-compose.
BACKEND_URL=http://localhost:8000

# Optional: only set if calling a backend on a different origin from the
# browser directly (bypassing the proxy route), e.g. local dev without
# Docker pointing at a remote staging server. Leave unset for normal use —
# an empty value means requests go to the frontend's own origin.
# NEXT_PUBLIC_API_URL=
