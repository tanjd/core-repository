# syntax=docker/dockerfile:1
#
# Build context is the repo root:
#   docker build -f apps/<%= name %>/Dockerfile .

# -----------------------------------------------------------------------------
# Stage 1: builder - install deps and app with uv; venv stays in /app/.venv
# -----------------------------------------------------------------------------
FROM python:3.13-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir uv

COPY --link apps/<%= name %>/pyproject.toml apps/<%= name %>/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --link apps/<%= name %>/src ./src/
COPY --link apps/<%= name %>/README.md ./
RUN uv sync --frozen --no-dev

# -----------------------------------------------------------------------------
# Stage 2: runtime - copy only venv + app; no uv, no build tools
# -----------------------------------------------------------------------------
FROM python:3.13-slim

WORKDIR /app

COPY --from=builder --link /app/.venv /app/.venv
COPY --from=builder --link /app/src /app/src

RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

EXPOSE 8080

CMD ["python", "-m", "<%= moduleName %>"]
