{
  "name": "telegram-bot-shared",
  "projectType": "library",
  "sourceRoot": "libs/telegram-bot-shared/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --locked",
        "cwd": "libs/telegram-bot-shared"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check . && uv run ruff format --check .",
        "cwd": "libs/telegram-bot-shared"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "libs/telegram-bot-shared"
      }
    }
  }
}
