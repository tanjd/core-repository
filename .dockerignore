**/node_modules
**/coverage
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/dist
**/.nx
.git
.devcontainer
.vscode
.cursor

# devcontainer-persisted tool caches (~10GB combined) — gitignored, never referenced by any
# Dockerfile, but not excluded by default like node_modules/.venv, so every build context (all
# builds use the repo root as context) paid to hash and transfer them
.cache
.pnpm-store

# secrets — real env files must never enter a build context (apps/*/.env.example and
# apps/*/.env.compose.example are checked-in templates, not secrets, and are unaffected —
# their filenames don't end in ".env")
**/.env
**/*.env

# runtime SQLite state — not build input; changes on every local dev run, which would
# otherwise bust the layer cache for any Dockerfile that copies its app dir wholesale
apps/bookshelf-backend/data
apps/food-maps-backend/data
apps/ledger-lens-backend/data
apps/index-watch/data

# defense-in-depth: catch stray db files anywhere else in the tree
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
